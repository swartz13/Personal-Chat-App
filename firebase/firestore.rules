rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Are we in the member list of the document? */
    function isMemberOf(data) {
      return isSignedIn() && request.auth.uid in data.members;
    }

    // Contact list: everyone who logged in can see others.
    // Because outside registration is closed, this list only consists of family members.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Voice/video call: connection information required for two phones
    // to find each other is exchanged here. Audio and video do not pass through here.
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      // No one can start a call on behalf of someone else.
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid;
      // Only the two sides of the call can change the state.
      allow update: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      // Everyone can delete the call history from their own calls.
      allow delete: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);

      match /{side}/{candidateId} {
        allow read, create, delete: if isSignedIn();
        allow update: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if isMemberOf(resource.data);
      // One-on-one chats are created on the first message; the person creating it must be a member.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members;
      allow update: if isMemberOf(resource.data);
      allow delete: if false;

      // The person's specific state in this chat (when they cleared the chat).
      match /state/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read: if isMemberOf(get(/databases/$(database)/documents/chats/$(chatId)).data);
        // No one can send a message on behalf of someone else.
        allow create: if isMemberOf(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;
        // Members can update for read receipt and "delete for me" mark.
        allow update: if isMemberOf(get(/databases/$(database)/documents/chats/$(chatId)).data);
        // The sender can only recall their own message if it has NOT BEEN READ YET.
        // If readBy only contains the sender themselves, it means the message has not been read.
        allow delete: if isMemberOf(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && resource.data.senderId == request.auth.uid
          && resource.data.readBy.hasOnly([request.auth.uid]);
      }
    }
  }
}
